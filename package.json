{
  "name": "usa-components",
  "version": "17.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run sandbox-icons && npm run docs:json && storybook dev -p 4200",
    "develop": "ng serve --port 4200",
    "build": "npm run build:components && npm run build:formly",
    "test": "npm run test:components && npm run test:formly",
    "build:components": "ng build uswds-components --configuration production",
    "build:formly": "ng build uswds-formly --configuration production",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "test:components": "ng test uswds-components --watch=false --code-coverage --no-progress",
    "test:formly": "ng test uswds-formly --watch=false --code-coverage --no-progress",
    "ghpages": "npm run build-storybook && touch storybook-static/.nojekyll && npx angular-cli-ghpages --dir=storybook-static",
    "docs:json": "compodoc -p ./tsconfig.json -e json -d .",
    "sandbox-icons": "node src/sandbox/generate-icons.js",
    "storybook-old": "ng run docs:json && ng run usa-components:storybook",
    "storybook": "ng run usa-components:storybook",
    "build-storybook": "ng run usa-components:build-storybook"
  },
  "private": true,
  "browser": {
    "fs": false,
    "os": false,
    "path": false
  },
  "dependencies": {
    "@angular/animations": "^18.2.14",
    "@angular/common": "^18.2.14",
    "@angular/compiler": "^18.2.14",
    "@angular/core": "^18.2.14",
    "@angular/forms": "^18.2.14",
    "@angular/platform-browser": "^18.2.14",
    "@angular/platform-browser-dynamic": "^18.2.14",
    "@angular/router": "^18.2.14",
    "@gsa-sam/sam-styles": "^3.0.12",
    "@ngx-formly/core": "^6.3.0",
    "core-js": "^3.21.1",
    "ngx-highlightjs": "4.1.3",
    "ngx-markdown": "^17.1.1",
    "rxjs": "~6.6.7",
    "tslib": "^2.0.0",
    "zone.js": "^0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.14",
    "@babel/core": "^7.17.8",
    "@chromatic-com/storybook": "^3.2.7",
    "@compodoc/compodoc": "^1.1.19",
    "@etchteam/storybook-addon-css-variables-theme": "^2.0.6",
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-links": "8.6.14",
    "@storybook/addon-mdx-gfm": "8.6.14",
    "@storybook/angular": "8.6.14",
    "@storybook/test": "^8.6.14",
    "@storybook/theming": "8.6.14",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^16.0.0",
    "angular-cli-github-pages": "0.2.0",
    "babel-loader": "^8.2.4",
    "codelyzer": "^6.0.0",
    "css-loader": "^6.5.1",
    "ejs": "^3.1.6",
    "jasmine-core": "^3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.3.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "ng-packagr": "^18.2.1",
    "protractor": "~7.0.0",
    "raw-loader": "^4.0.2",
    "storybook": "8.6.14",
    "storybook-addon-preview": "^2.3.0",
    "ts-node": "~8.3.0",
    "tslint": "~6.1.0",
    "typescript": "^5.2.2"
  }
}
